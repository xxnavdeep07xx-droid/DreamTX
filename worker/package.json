{
  "name": "dreamtx-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:wasm": "wasm-pack build ../core/crates/deck-core --target web --out-dir ../worker/wasm --release --features wasm",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/",
    "dev": "npm run build:wasm && wrangler dev",
    "deploy": "npm run build:wasm && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241224.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
